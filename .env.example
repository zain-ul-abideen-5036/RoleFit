# ---------------------------------------------------------------------------
# RoleFit — environment configuration
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# Public origin of the app. REQUIRED in production.
#
# Used for SEO metadata, the sitemap, and — critically — as the allowed origin
# for the CSRF check. Left unset in production it falls back to localhost, and
# every sign-in, upload and export is then refused with a 403. Startup
# validation fails rather than letting that happen silently.
#
# On Vercel the platform-provided VERCEL_URL / VERCEL_BRANCH_URL /
# VERCEL_PROJECT_PRODUCTION_URL are trusted automatically, so preview
# deployments work without configuring their generated hostnames.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment. Set automatically by Next.js; override only in tooling.
# NODE_ENV=development

# --- Database --------------------------------------------------------------
# PostgreSQL connection string.
# Local docker: postgresql://rolefit:rolefit@localhost:5433/rolefit
# Production (Neon/Supabase/RDS) must use sslmode=require.
DATABASE_URL=postgresql://rolefit:rolefit@localhost:5433/rolefit

# Max pooled connections. Keep low on serverless (1–5).
DATABASE_POOL_MAX=5

# --- Authentication --------------------------------------------------------
# 32+ byte random secret used to sign session JWTs.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars

# Session lifetime in seconds (default 7 days).
AUTH_SESSION_TTL=604800

# --- AI provider -----------------------------------------------------------
# One of: deterministic | anthropic | openai
# `deterministic` runs the offline rule-based engine (no API key, no network).
AI_PROVIDER=deterministic

# API key for the selected provider. SERVER-SIDE ONLY — never prefix NEXT_PUBLIC_.
AI_API_KEY=

# Optional model override. Defaults per provider:
#   anthropic -> claude-sonnet-5
#   openai    -> gpt-4o-mini
AI_MODEL=

# Hard timeout (ms) for a single AI request.
AI_TIMEOUT_MS=45000

# Max attempts for a schema-invalid AI response before failing closed.
AI_MAX_REPAIR_ATTEMPTS=2

# --- Object storage --------------------------------------------------------
# One of: local | s3
# `local` writes to ./.storage and is for development only. It is not durable
# on serverless hosting, where the filesystem is discarded between requests.
# Production uses `s3`, which speaks the S3 API to any compatible provider.
STORAGE_DRIVER=local

# S3-compatible endpoint. Backblaze B2 is the documented production provider
# (see docs/deployment.md); AWS S3, MinIO and Cloudflare R2 also work.
#   Backblaze B2  https://s3.<region>.backblazeb2.com   e.g. s3.us-west-004...
#   AWS S3        leave blank
STORAGE_ENDPOINT=

# REQUIRED when STORAGE_DRIVER=s3, with no default, because the region forms
# part of the request signature — a wrong value is rejected as an opaque 403 on
# the first upload rather than at startup. It must match the region inside
# STORAGE_ENDPOINT, which is checked when the app boots.
#   Backblaze B2  the region in your endpoint, e.g. us-west-004
#   AWS S3        the bucket's region, e.g. eu-central-1
#   Cloudflare R2 auto
STORAGE_REGION=

# Backblaze B2: keyID and applicationKey from an application key restricted to
# the one bucket. Never commit real values.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# REQUIRED when STORAGE_DRIVER=s3. Bucket names are globally unique on
# Backblaze B2, so yours will need its own name.
STORAGE_BUCKET=

# Path-style addressing puts the bucket in the URL path rather than the
# hostname: https://s3.<region>.backblazeb2.com/<bucket>/<key>. That is the
# form Backblaze documents, and MinIO requires it. Both styles work against B2.
STORAGE_FORCE_PATH_STYLE=true

# Lifetime of presigned download URLs, in seconds. Short by design: the URL is
# the only thing standing between a leaked link and someone's resume.
STORAGE_SIGNED_URL_TTL=300

# --- Rate limiting ---------------------------------------------------------
# One of: memory | upstash
# `memory` is per-instance only and does NOT protect a multi-instance
# serverless deployment. Use `upstash` in production.
RATE_LIMIT_DRIVER=memory

# Scales every rate-limit bucket. Exists so load tests and end-to-end runs can
# exercise the real limiter instead of bypassing it. Leave at 1 in production.
RATE_LIMIT_MULTIPLIER=1

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Embeddings ------------------------------------------------------------
# Used ONLY to suggest the closest thing your resume already says to a
# requirement it does not meet. One of: none | openai
#
# Nothing here influences a score, a match decision, or whether a requirement
# counts as met — those stay lexical and deterministic. Turning this off removes
# one advisory line from the gap list and nothing else.
EMBEDDINGS_PROVIDER=none

# API key for the selected provider. SERVER-SIDE ONLY.
EMBEDDINGS_API_KEY=

# Optional model override. Default: text-embedding-3-small (1536 dimensions).
EMBEDDINGS_MODEL=

# --- Background work -------------------------------------------------------
# How optimization work is executed. One of: inline | database
#
# `inline` (default) runs it inside the request. Right while a deterministic run
# finishes in well under a second, and it needs no extra process.
#
# `database` writes a job and returns immediately; a separate long-lived worker
# (`npm run worker`) claims and runs it. Needed for a slower AI provider or
# batch work. The worker is not a serverless function — claiming is a loop.
QUEUE_DRIVER=inline

# Seconds a worker waits before polling again when the queue is empty.
QUEUE_POLL_SECONDS=5

# --- Email -----------------------------------------------------------------
# Transactional email, used only for address verification and password reset.
# One of: none | console | resend
#
# `none` (default) disables both flows. The app stays fully usable and the UI
# stops offering them, rather than showing a reset link that does nothing.
#
# `console` writes the message to stderr instead of sending it, for local
# development. Outside development the body is withheld, because it contains a
# single-use link. It is refused outright on hosted platforms, where nothing
# would ever be delivered.
#
# `resend` sends for real and needs both variables below.
EMAIL_PROVIDER=none

# Resend API key. SERVER-SIDE ONLY — never prefix NEXT_PUBLIC_.
EMAIL_API_KEY=

# Sender address, on a domain verified with the provider.
# Example: RoleFit <no-reply@your-domain.example>
EMAIL_FROM=

# --- Analytics -------------------------------------------------------------
# One of: none | console | posthog
ANALYTICS_PROVIDER=none
ANALYTICS_KEY=
ANALYTICS_HOST=

# --- Limits ----------------------------------------------------------------
# Max upload size in bytes (default 5 MB). Vercel caps request bodies at 4.5 MB
# on serverless functions — keep at or below that for hosted deployments.
MAX_UPLOAD_BYTES=4500000

# --- Observability ---------------------------------------------------------
# One of: debug | info | warn | error
LOG_LEVEL=info
