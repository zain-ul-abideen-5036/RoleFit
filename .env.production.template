# ---------------------------------------------------------------------------
# RoleFit — production configuration
#
# Do not edit this file. Run:
#
#   npm run deploy:init
#
# That writes .env.production.local from this template with a freshly
# generated AUTH_SECRET, leaving you only the blanks below to fill in.
# Then:
#
#   npm run deploy:preflight
#
# This template is committed, so AUTH_SECRET here is a placeholder rather than
# a real value — a secret in version control is a secret that has leaked.
# .env.production.local is gitignored and is where the real one lives.
# ---------------------------------------------------------------------------


# ===========================================================================
# YOU FILL THESE IN  —  five values, from three dashboards
# ===========================================================================

# --- 1. Neon --------------------------------------------------------------
# The POOLED connection string. Its host contains "-pooler".
# Must end with ?sslmode=require
DATABASE_URL=

# --- 2. Backblaze B2 ------------------------------------------------------
# From the bucket's "Endpoint" line, prefixed with https://
# e.g. https://s3.us-west-004.backblazeb2.com
STORAGE_ENDPOINT=

# The region inside that endpoint — the part between "s3." and ".backblazeb2.com"
# e.g. us-west-004
STORAGE_REGION=

# keyID and applicationKey from an application key scoped to the one bucket
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Your bucket's name (globally unique on B2, so it will be your own)
STORAGE_BUCKET=

# --- 3. Upstash (recommended; free) ---------------------------------------
# From the REST API section of the database page. Leave both blank and set
# RATE_LIMIT_DRIVER=memory below if you skip Upstash.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ===========================================================================
# ALREADY SET  —  do not change these unless you know why
# ===========================================================================

# Signs every session cookie. `npm run deploy:init` replaces this placeholder
# with 48 random bytes, unique to your deployment. Changing it later signs
# everyone out, which is also the emergency lever if it ever leaks.
AUTH_SECRET=__GENERATED_BY_DEPLOY_INIT__

# Session lifetime, 7 days.
AUTH_SESSION_TTL=604800

# Low on serverless: each instance is a separate process holding its own pool.
DATABASE_POOL_MAX=2

# Object storage over the S3 API.
STORAGE_DRIVER=s3
# Bucket in the URL path — the form Backblaze documents.
STORAGE_FORCE_PATH_STYLE=true
# Download links expire in 5 minutes.
STORAGE_SIGNED_URL_TTL=300

# Shared counters across instances. Set to "memory" only if you skipped Upstash.
RATE_LIMIT_DRIVER=upstash
# Leave at 1. Raising it weakens abuse protection everywhere.
RATE_LIMIT_MULTIPLIER=1

# The offline rule-based engine: no API key, no network, nothing leaves the box.
# Change to "anthropic" or "openai" (and set AI_API_KEY) for LLM rewriting.
AI_PROVIDER=deterministic
AI_API_KEY=
AI_TIMEOUT_MS=45000
AI_MAX_REPAIR_ATTEMPTS=2

# Password reset and email verification are off. The UI hides them entirely
# rather than offering a link that cannot work.
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=

# Optimization runs inside the request. A deterministic run takes well under a
# second, so this needs no extra process. "database" requires a worker.
QUEUE_DRIVER=inline

# Advisory gap hints, off. Enabling this sends resume text to a third party.
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_API_KEY=

ANALYTICS_PROVIDER=none

# Vercel rejects request bodies above 4.5 MB before your code runs.
MAX_UPLOAD_BYTES=4500000

LOG_LEVEL=info

# Added AFTER the first deploy, once Vercel gives you a URL. It is compiled
# into the browser bundle, so it needs a redeploy to take effect.
#
# Leave it commented out until you have a real value. Creating it empty is not
# the same as leaving it unset, and the app falls back to the hostname the
# platform assigns in the meantime.
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
